# Copy to .env and fill in. .env is git-ignored.
# Without GOOGLE_CLIENT_ID the app runs in local mode (no login, no Drive, download instead).

# From Google Cloud > Google Auth Platform > Clients
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google accounts allowed to use the app, comma separated
ALLOWED_EMAIL=a@gmail.com,b@gmail.com

# Encrypts the login cookie. Optional locally (a random one is used and logins
# reset on restart); required when hosted. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: upload each song to a YouTube channel (private). Get it from /yt-token-helper,
# authorised with the channel's account. Treat it as a secret.
# YT_REFRESH_TOKEN=

# Optional: Slack Incoming Webhook, posts when a job starts, finishes or fails.
# Treat the URL as a secret.
# SLACK_WEBHOOK_URL=

# Optional
# DRIVE_FOLDER_NAME=YT MUSIC PUBLISHER
# TZ_NAME=Asia/Taipei
# RENDER_TIMEOUT_MIN=20
